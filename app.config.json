{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Audio to MIDI",
  "nameJa": "音声→MIDI",
  "slug": "audio-to-midi",
  "version": "0.8.0",
  "description": "Convert short audio recordings to MIDI, entirely on your device.",
  "descriptionJa": "短い音声を端末内だけで解析し、MIDIへ変換します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-audio-to-midi"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
